<Window x:Class="SpaceSense.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Sense" Width="1380" Height="850" MinWidth="1100" MinHeight="680"
        Background="#0D1522" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="SPACE SENSE" FontWeight="Bold" FontSize="13" Foreground="#68DCC1" />
                <TextBlock Text="Make room. Understand the trade-off." FontWeight="SemiBold" FontSize="27" Margin="0,8,0,5" />
                <TextBlock Text="Explore your storage and learn what removing an item could affect." Foreground="{StaticResource Muted}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#18352F" CornerRadius="12" Padding="13,7">
                <TextBlock Text="READ-ONLY PREVIEW" Foreground="#80E2C9" FontSize="11" FontWeight="SemiBold" />
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#172233" CornerRadius="6" Padding="14,11" Margin="0,0,12,0">
                <TextBlock x:Name="ScanPath" Text="Choose a folder or drive to begin" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
            </Border>
            <Button x:Name="ChooseButton" Grid.Column="1" Content="Choose folder / drive" Click="ChooseFolder_Click" Background="#68DCC1" Foreground="#0D2520" FontWeight="SemiBold" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Margin="10,0,0,0" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Background="#111B2A" CornerRadius="8" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="FOLDERS" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
                        <TextBlock Text="Explore one level at a time" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#172233" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SCANNED FILE SIZE" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="TotalSize" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,5" />
                        <TextBlock x:Name="ScanSummary" Text="Your files stay on your computer." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="Logical sizes • not an estimate of space recoverable by deletion" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#172233" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SPACE AT A GLANCE" Foreground="{StaticResource Muted}" FontSize="11" />
                        <Grid x:Name="SizeMap" Height="36" Margin="0,12,0,8" />
                        <TextBlock Text="Select a segment to inspect it. Double-click a folder below to explore." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="#172233" CornerRadius="8" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="UpButton" Content="↑ Up" Click="Up_Click" IsEnabled="False" Padding="8,5" Margin="0,0,10,0" />
                            <TextBlock x:Name="CurrentFolder" Grid.Column="1" Text="No folder selected" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None" RowHeaderWidth="0"
                                  SelectionChanged="ItemsGrid_SelectionChanged" MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" SortMemberPath="Bytes" Width="145" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Column="4" Background="#172233" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="BEFORE YOU REMOVE IT" FontSize="11" Foreground="#68DCC1" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailName" Text="Understand an item" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,7" />
                        <TextBlock x:Name="DetailPath" Text="Select a file or folder to see its purpose, risks, and recommended next step." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <Border Background="#26354B" CornerRadius="5" Padding="10" Margin="0,16,0,16">
                            <TextBlock x:Name="AssessmentLabel" Text="Awaiting selection" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="WHAT IT DOES" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="PurposeText" Text="—" TextWrapping="Wrap" Margin="0,6,0,18" />
                        <TextBlock Text="WHAT DELETING IT MEANS" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ImpactText" Text="—" TextWrapping="Wrap" Margin="0,6,0,18" />
                        <TextBlock Text="RECOMMENDED NEXT STEP" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="RecommendationText" Text="—" TextWrapping="Wrap" Margin="0,6,0,18" />
                        <Separator Background="#32425A" Margin="0,0,0,18" />
                        <TextBlock Text="BASIS FOR THIS ASSESSMENT" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="EvidenceText" Text="Local rules. No file contents are read." TextWrapping="Wrap" Margin="0,6,0,8" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ConfidenceText" Text="" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="This preview cannot delete files. A size or assessment is never a guarantee of safe removal." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,24,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <ProgressBar x:Name="ScanActivity" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10" />
            <TextBlock x:Name="StatusText" Text="Ready • Local metadata only • No administrator access requested" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <Expander x:Name="WarningsPanel" Header="Scan notes" Visibility="Collapsed" Foreground="#A7B4C8" Margin="0,8,0,0">
                <TextBox x:Name="WarningsText" IsReadOnly="True" MaxHeight="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111B2A" Foreground="#A7B4C8" BorderThickness="0" Padding="8" />
            </Expander>
        </StackPanel>
    </Grid>
</Window>
